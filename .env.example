# Copy to .env.local and fill in. See docker-compose.yml for the local
# Postgres credentials matching the default value below.
DATABASE_URL="postgresql://fandan:fandan@localhost:5432/fandan"

# Required from M4 onward, when AI SDK tool calls start hitting the API.
ANTHROPIC_API_KEY=""

# Model IDs used by the AI SDK provider config. See docs/DECISIONS.md ADR-001.
MODEL_PLANNER="claude-sonnet-5"
MODEL_PARSER="claude-haiku-4-5-20251001"

# --- M6: Supabase Auth (not needed before then) ---
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
